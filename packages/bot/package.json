    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.32.0",
    "fastify": "^4.28.1",
    "jose": "^5.6.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.0.5",
    "drizzle-kit": "^0.23.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
