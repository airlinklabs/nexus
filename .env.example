# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot configuration
GUILD_ID=          # optional — for dev guild-scoped command registration
NODE_ENV=development

# API server
PORT=3001
API_SECRET=        # random 64-char hex string — used to authenticate internal calls
API_BASE_URL=http://localhost:3001   # set to your Railway URL in production

# Database
DATABASE_PATH=     # optional — defaults to ./nexus.db in dev, /data/nexus.db on Railway
